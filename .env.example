# Скопируйте в .env для локального запуска без Docker
DATABASE_URL=postgresql+asyncpg://alfa_user:alfa_password@localhost:5432/alfa_credit_db
SQL_ECHO=false
# ИИ-объяснение решения: адрес Ollama. Пусто — шаблонное объяснение
LLM_URL=
LLM_MODEL=qwen2.5:7b-instruct
LLM_TIMEOUT=60
# Вход сотрудников банка в /bank и /metrics
BANK_PASSWORD=alfa-analyst
SESSION_SECRET=dev-secret-change-me
